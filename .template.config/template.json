{
  "$schema": "http://json.schemastore.org/template",
  "author": "",
  "classifications": [ "Cross-Platform", "Avalonia", "Clean Architecture", "MVVM" ],
  "identity": "AvaloniaCleanXplat.Template",
  "name": "Avalonia Clean Architecture Cross-Platform",
  "shortName": "avalonia-clean-xplat",
  "sourceName": "MyApp",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "symbols": {
    "NoApi": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "longName": "no-api",
      "description": "Exclude the API layer (Infrastructure, API projects and their tests)"
    },
    "NoBrowser": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "longName": "no-browser",
      "description": "Exclude the Browser (WASM) target"
    },
    "AvaloniaVersion": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "12.0.2",
      "longName": "avalonia-version",
      "replaces": "12.0.2",
      "description": "The Avalonia package version to use"
    }
  },
  "sources": [
    {
      "source": "./",
      "target": "./",
      "modifiers": [
        {
          "condition": "NoApi",
          "exclude": [
            "src/MyApp.Infrastructure/**",
            "src/MyApp.API/**",
            "src/MyApp.Infrastructure.Tests/**",
            "src/MyApp.API.Tests/**"
          ]
        },
        {
          "condition": "NoBrowser",
          "exclude": [
            "src/MyApp.Browser/**"
          ]
        }
      ]
    }
  ],
  "specialCustomOperations": {
    "**/*.slnx": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": [ "<!--#if" ],
            "else": [ "<!--#else" ],
            "elseif": [ "<!--#elseif" ],
            "endif": [ "<!--#endif" ],
            "trim": true,
            "wholeLine": true,
            "evaluator": "C++"
          }
        }
      ]
    }
  }
}
